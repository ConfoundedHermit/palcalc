<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI">

    <!--
        ============================================================
        DesignTokens.xaml — Pal Calc design system (Phase 1)
        ============================================================
        Centralized, reusable design tokens for consistent spacing,
        typography, corner radii, elevation, and semantic colors.

        This dictionary is ADDITIVE and non-destructive:
          - It introduces new resource keys only.
          - It builds on top of AdonisUI brush/color keys.
          - It changes no ViewModels, bindings, or behavior.

        Naming conventions:
          - Spacing:   Space.XS / Space.SM / Space.MD / Space.LG / Space.XL
                       (Double, Thickness, and GridLength variants)
          - Type:      FontSize.Caption / .Body / .Subtitle / .Title / .Header
          - Radii:     CornerRadius.Small / .Medium / .Large / .Pill
          - Elevation: Elevation.* brushes (aliases over AdonisUI layers)
          - Semantic:  Brush.Success / .Warning / .Error / .Info
        ============================================================
    -->

    <!-- ==================== Spacing scale (Double) ==================== -->
    <sys:Double x:Key="Space.XS">2</sys:Double>
    <sys:Double x:Key="Space.SM">5</sys:Double>
    <sys:Double x:Key="Space.MD">10</sys:Double>
    <sys:Double x:Key="Space.LG">15</sys:Double>
    <sys:Double x:Key="Space.XL">25</sys:Double>

    <!-- ==================== Spacing scale (Thickness) ==================== -->
    <Thickness x:Key="Thickness.XS">2</Thickness>
    <Thickness x:Key="Thickness.SM">5</Thickness>
    <Thickness x:Key="Thickness.MD">10</Thickness>
    <Thickness x:Key="Thickness.LG">15</Thickness>
    <Thickness x:Key="Thickness.XL">25</Thickness>

    <!-- Common asymmetric paddings used by cards/sections -->
    <Thickness x:Key="Padding.Card">10</Thickness>
    <Thickness x:Key="Padding.Section">10,8,10,10</Thickness>

    <!-- ==================== Spacing scale (GridLength) ==================== -->
    <GridLength x:Key="GridLength.XS">2</GridLength>
    <GridLength x:Key="GridLength.SM">5</GridLength>
    <GridLength x:Key="GridLength.MD">10</GridLength>
    <GridLength x:Key="GridLength.LG">15</GridLength>
    <GridLength x:Key="GridLength.XL">25</GridLength>

    <!-- ==================== Typography scale ==================== -->
    <sys:Double x:Key="FontSize.Caption">10</sys:Double>
    <sys:Double x:Key="FontSize.Body">12</sys:Double>
    <sys:Double x:Key="FontSize.Subtitle">14</sys:Double>
    <sys:Double x:Key="FontSize.Title">16</sys:Double>
    <sys:Double x:Key="FontSize.Header">20</sys:Double>

    <FontWeight x:Key="FontWeight.Normal">Normal</FontWeight>
    <FontWeight x:Key="FontWeight.Medium">Medium</FontWeight>
    <FontWeight x:Key="FontWeight.Semibold">SemiBold</FontWeight>
    <FontWeight x:Key="FontWeight.Bold">Bold</FontWeight>

    <!-- ==================== Corner radius tokens ==================== -->
    <CornerRadius x:Key="CornerRadius.Small">2</CornerRadius>
    <CornerRadius x:Key="CornerRadius.Medium">4</CornerRadius>
    <CornerRadius x:Key="CornerRadius.Large">8</CornerRadius>
    <CornerRadius x:Key="CornerRadius.Pill">99</CornerRadius>

    <!-- ==================== Elevation / layer brushes ==================== -->
    <!--
        Elevation is expressed via AdonisUI's layered background brushes
        (Layer0/1/2 BackgroundBrush). The reusable Card/Section styles in
        ControlStyles.xaml reference those brushes directly with
        DynamicResource so surfaces follow theme/color-scheme swaps.
    -->

    <!-- ==================== Semantic colors ==================== -->
    <!--
        Consolidated palette. Values mirror the existing AdonisUI color
        overrides (see StyleAdjustments.xaml) so semantic and raw usages
        stay in sync. Exposed as both Color and Brush for flexibility.
    -->
    <Color x:Key="Color.Success">#4CAF50</Color>
    <Color x:Key="Color.Warning">#D49220</Color>
    <Color x:Key="Color.Error">#FF3939</Color>
    <Color x:Key="Color.Info">#5CA8FF</Color>

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}" />
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}" />

</ResourceDictionary>
