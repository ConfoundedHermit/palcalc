<Page x:Class="PalCalc.UI.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:PalCalc.UI"
      xmlns:v="clr-namespace:PalCalc.UI.View.Main"
      xmlns:vm="clr-namespace:PalCalc.UI.ViewModel"
      xmlns:itl="clr-namespace:PalCalc.UI.Localization"
      xmlns:c="clr-namespace:PalCalc.UI.ViewModel.Converters"
      xmlns:b="clr-namespace:PalCalc.UI.ViewModel.Behaviors"
      xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
      xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
      xmlns:vu="clr-namespace:PalCalc.UI.View.Utils"
      xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"

      mc:Ignorable="d"
      d:Width="1280" d:Height="720"
      VerticalAlignment="Stretch"
      HorizontalAlignment="Stretch"
      d:DataContext="{d:DesignInstance vm:MainWindowViewModel, IsDesignTimeCreatable=True}" d:DesignHeight="1351" d:DesignWidth="1659">
    <Page.Resources>
        <c:ValueVisibilityConverter x:Key="VVC" />
        <c:ValueBoolConverter x:Key="NegatedVBC" Negate="True" />
    </Page.Resources>
    <Page.Triggers>
        <!--
            Subtle, one-shot fade-in when the main page first appears
            (Loading -> Main transition). Cheap and non-distracting;
            purely visual, no behavior change.
        -->
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.25" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>
    <Border Padding="5">

        <DockPanel>
            <Menu DockPanel.Dock="Top" Background="{DynamicResource {x:Static adonisUi:Brushes.Layer2BackgroundBrush}}">
                <MenuItem Header="{itl:LocalizedText LC_LANGUAGE}" ItemsSource="{Binding Locales}" Padding="5">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding Label}" />
                            <Setter Property="IsCheckable" Value="True" />
                            <Setter Property="IsChecked" Value="{Binding IsSelected}" />
                            <Setter Property="Command" Value="{Binding SelectCommand}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="{itl:LocalizedText LC_THEME}" ItemsSource="{Binding Themes}" Padding="5">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding Label.Value}" />
                            <Setter Property="IsCheckable" Value="True" />
                            <Setter Property="IsChecked" Value="{Binding IsSelected}" />
                            <Setter Property="Command" Value="{Binding SelectCommand}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="Debug" Padding="5" Name="DebugMenuItem">
                    <MenuItem Header="Translation Debugger" Click="TranslationDebugger_Click" />
                </MenuItem>

            </Menu>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MinWidth="220" Width="300"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="232*" MinWidth="250" />
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80*" MinWidth="280"/>
                </Grid.ColumnDefinitions>
                <!-- Left-hand Pane -->
                <DockPanel Grid.Column="0">
                    <StackPanel DockPanel.Dock="Top" vu:StackPanelExtensions.Spacing="5">
                        <!-- "Save File" section -->
                        <Expander IsExpanded="True" adonisExtensions:LayerExtension.IncreaseLayer="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialIcons:MaterialIcon Kind="ContentSaveOutline" Style="{StaticResource SectionHeaderIconStyle}" />
                                    <TextBlock Text="{itl:LocalizedText LC_SAVE_FILE}" />
                                </StackPanel>
                            </Expander.Header>
                            <v:SaveSelectorView DataContext="{Binding SaveSelection}" AllowNavigation="{Binding RelativeSource={RelativeSource AncestorType=local:MainPage}, Path=DataContext.SolverQueue.QueuedItems.Count, Converter={StaticResource NegatedVBC}}" />
                        </Expander>

                        <!-- "Game Settings" section -->
                        <Expander IsExpanded="True" adonisExtensions:LayerExtension.IncreaseLayer="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialIcons:MaterialIcon Kind="CogOutline" Style="{StaticResource SectionHeaderIconStyle}" />
                                    <TextBlock Text="{itl:LocalizedText LC_GAME_SETTINGS}" />
                                </StackPanel>
                            </Expander.Header>
                            <v:GameSettingsView DataContext="{Binding SelectedGameSettings}" />
                        </Expander>

                    </StackPanel>

                    <Grid Margin="0,5,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition MinHeight="100" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- "Target Pals" section -->
                        <GroupBox Grid.Row="0">
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialIcons:MaterialIcon Kind="BullseyeArrow" Style="{StaticResource SectionHeaderIconStyle}" />
                                    <TextBlock Text="{itl:LocalizedText LC_TARGET_PALS}" />
                                </StackPanel>
                            </GroupBox.Header>
                            <v:PalTargetListView BorderThickness="0" DataContext="{Binding PalTargetList}" />
                        </GroupBox>


                        <Grid Visibility="{Binding SolverQueue.QueuedItems.Count, Converter={StaticResource VVC}}" Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <GridSplitter Grid.Row="0" Background="{x:Null}" Height="5" ResizeBehavior="CurrentAndNext" IsEnabled="{Binding ElementName=JobQueueExpander, Path=IsExpanded}" />

                            <!-- "Jobs" section -->
                            <Expander Header="{Binding SolverQueue.SectionTitleWithCount.Value}"
                                      Grid.Row="1"
                                      Visibility="{Binding SolverQueue.QueuedItems.Count, Converter={StaticResource VVC}}"
                                      IsExpanded="True"
                                      VerticalContentAlignment="Stretch"
                                      adonisExtensions:LayerExtension.IncreaseLayer="True"
                                      Name="JobQueueExpander"
                                      >
                                <i:Interaction.Behaviors>
                                    <b:ExpanderGridRowResetBehavior TargetGridRowIndex="1" ExpandedMinHeight="100" />
                                </i:Interaction.Behaviors>
                                <ScrollViewer>
                                    <v:SolverQueueView DataContext="{Binding SolverQueue}" />
                                </ScrollViewer>
                            </Expander>
                        </Grid>
                    </Grid>
                </DockPanel>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

                <!-- Center Pane -->
                <DockPanel Grid.Column="2">
                    <!-- Solver controls at the top -->
                    <v:SolverControlsView DockPanel.Dock="Top" DataContext="{Binding SolverControls}" Margin="0,0,0,5" Padding="5" HorizontalContentAlignment="Right" Background="{DynamicResource ResourceKey={x:Static adonisUi:Brushes.Layer1BackgroundBrush}}" adonisExtensions:LayerExtension.IncreaseLayer="True" />

                    <!-- Progress bar at the bottom -->
                    <StackPanel DockPanel.Dock="Bottom"
                                Visibility="{Binding PalTarget.CurrentPalSpecifier.LatestJob, Converter={StaticResource VVC}, FallbackValue=Collapsed, Mode=OneWay}"
                                >
                        <Grid Margin="0,0,0,2">
                            <ProgressBar Height="22" Value="{Binding PalTarget.CurrentPalSpecifier.LatestJob.SolverProgress, Mode=OneWay}" adonisExtensions:ProgressBarExtension.IsProgressAnimationEnabled="False" />
                            <TextBlock Text="{Binding PalTarget.CurrentPalSpecifier.LatestJob.SolverStatusMessage.Value}" Style="{StaticResource ProgressOverlayTextStyle}" />
                        </Grid>
                        <Grid>
                            <ProgressBar Height="22" Value="{Binding PalTarget.CurrentPalSpecifier.LatestJob.StepProgress, Mode=OneWay}" adonisExtensions:ProgressBarExtension.IsProgressAnimationEnabled="False" />
                            <TextBlock Text="{Binding PalTarget.CurrentPalSpecifier.LatestJob.StepStatusMessage.Value}" Style="{StaticResource ProgressOverlayTextStyle}" />
                        </Grid>

                    </StackPanel>

                    <!-- Graph view -->
                    <v:BreedingResultView DataContext="{Binding PalTarget.CurrentPalSpecifier.CurrentResults.SelectedResult}" />
                </DockPanel>

                <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

                <!-- Right-hand Pane -->
                <Grid Grid.Column="4">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- "Target Pal" section -->
                    <Expander Grid.Row="0"
                              IsExpanded="True"
                              adonisExtensions:LayerExtension.IncreaseLayer="True"
                              >
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Kind="Target" Style="{StaticResource SectionHeaderIconStyle}" />
                                <TextBlock Text="{itl:LocalizedText LC_TARGET_PAL}" />
                            </StackPanel>
                        </Expander.Header>
                        <Border IsEnabled="{Binding PalTarget.CanEdit}">
                            <v:PalTargetView DataContext="{Binding PalTarget}" />
                        </Border>
                    </Expander>


                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="60*" MinHeight="150" />
                        </Grid.RowDefinitions>

                        <!-- "Source Pals" section -->
                        <Expander Grid.Row="0" Margin="0,5,0,0" Padding="0" IsExpanded="True" Name="SourcePalsExpander" VerticalContentAlignment="Stretch" adonisExtensions:LayerExtension.IncreaseLayer="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialIcons:MaterialIcon Kind="AccountGroupOutline" Style="{StaticResource SectionHeaderIconStyle}" />
                                    <TextBlock Text="{itl:LocalizedText LC_SOURCE_PALS}" />
                                </StackPanel>
                            </Expander.Header>

                            <i:Interaction.Behaviors>
                                <b:ExpanderGridRowResetBehavior TargetGridRowIndex="0" ExpandedMinHeight="120" />
                            </i:Interaction.Behaviors>

                            <ScrollViewer Padding="0">
                                <Grid IsEnabled="{Binding PalTarget.CanEdit}" VerticalAlignment="Stretch" Margin="{adonisUi:Space 1, 1}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" vu:StackPanelExtensions.Spacing="8">
                                        <Label Style="{StaticResource SectionHeaderLabelStyle}" Content="{itl:LocalizedText Code=LC_SOURCE_PALS_FILTERS}" />
                                        <StackPanel vu:StackPanelExtensions.Spacing="5">
                                            <CheckBox Style="{StaticResource StandardCheckBoxStyle}" IsChecked="{Binding PalTarget.CurrentPalSpecifier.IncludeGlobalStoragePals}">
                                                <TextBlock Text="{itl:LocalizedText Code=LC_INCLUDE_PALS_GPS}" TextWrapping="Wrap" />
                                            </CheckBox>
                                    
                                            <CheckBox Style="{StaticResource StandardCheckBoxStyle}" IsChecked="{Binding PalTarget.CurrentPalSpecifier.IncludeBasePals}">
                                                <TextBlock Text="{itl:LocalizedText LC_INCLUDE_PALS_AT_BASE}" TextWrapping="Wrap" />
                                            </CheckBox>

                                            <CheckBox Style="{StaticResource StandardCheckBoxStyle}" IsChecked="{Binding PalTarget.CurrentPalSpecifier.IncludeCagedPals}">
                                                <TextBlock Text="{itl:LocalizedText Code=LC_INCLUDE_PALS_IN_CAGES}" TextWrapping="Wrap" />
                                            </CheckBox>

                                            <CheckBox Style="{StaticResource StandardCheckBoxStyle}" IsChecked="{Binding PalTarget.CurrentPalSpecifier.IncludeCustomPals}">
                                                <TextBlock Text="{itl:LocalizedText Code=LC_INCLUDE_CUSTOM_PALS}" TextWrapping="Wrap" />
                                            </CheckBox>

                                            <CheckBox Style="{StaticResource StandardCheckBoxStyle}" IsChecked="{Binding PalTarget.CurrentPalSpecifier.IncludeExpeditionPals}">
                                                <TextBlock Text="{itl:LocalizedText Code=LC_INCLUDE_PALS_ON_EXPEDITIONS}" TextWrapping="Wrap" />
                                            </CheckBox>
                                        </StackPanel>
                                    </StackPanel>

                                    <Separator Grid.Row="1" Visibility="Hidden" Margin="0,10,0,10" />

                                    <StackPanel Grid.Row="2" vu:StackPanelExtensions.Spacing="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0"
                                                   Style="{StaticResource SectionHeaderLabelStyle}"
                                                   Content="{itl:LocalizedText Code=LC_SOURCE_PALS_PLAYERS_AND_GUILDS}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource IconButtonStyle}"
                                                        Command="{Binding PalTarget.PalSource.SelectAllCommand}"
                                                        ToolTip="{itl:LocalizedText Code=LC_SOURCE_PALS_SELECT_ALL}">
                                                    <materialIcons:MaterialIcon Kind="CheckboxMultipleMarkedOutline" Width="16" Height="16" />
                                                </Button>
                                                <Button Style="{StaticResource IconButtonStyle}"
                                                        Command="{Binding PalTarget.PalSource.SelectNoneCommand}"
                                                        ToolTip="{itl:LocalizedText Code=LC_SOURCE_PALS_SELECT_NONE}">
                                                    <materialIcons:MaterialIcon Kind="CheckboxMultipleBlankOutline" Width="16" Height="16" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{DynamicResource {x:Static adonisUi:Brushes.DisabledForegroundBrush}}"
                                                   Text="{Binding PalTarget.PalSource.SelectionSummary.Value}" />
                                        <v:PalSourceTreeView DataContext="{Binding PalTarget.PalSource}">

                                            <v:PalSourceTreeView.Resources>
                                                <Style TargetType="TreeView" BasedOn="{StaticResource {x:Type TreeView}}">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="TreeView">
                                                                <Border Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="{TemplateBinding adonisExtensions:CornerRadiusExtension.CornerRadius}"
                                                                            Padding="{TemplateBinding Padding}">
                                                                    <!-- Remove ScrollViewer that normally wraps this, so it doesn't interfere with the ScrollViewer containing this whole section -->
                                                                    <ItemsPresenter />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </v:PalSourceTreeView.Resources>
                                        </v:PalSourceTreeView>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Expander>

                        <GridSplitter IsEnabled="{Binding ElementName=SourcePalsExpander, Path=IsExpanded}" Grid.Row="1" Background="{x:Null}" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" />

                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal"
                                        Grid.Row="0"
                                        Margin="5"
                                        Visibility="{Binding ShowNoResultsNotice, Converter={StaticResource VVC}, FallbackValue=Collapsed}">
                                <materialIcons:MaterialIcon Kind="InformationOutline"
                                                            Width="16" Height="16"
                                                            VerticalAlignment="Top"
                                                            Margin="0,2,6,0"
                                                            Foreground="{DynamicResource {x:Static adonisUi:Brushes.HyperlinkBrush}}" />
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{itl:LocalizedText Code=LC_NO_RESULTS_FAQ_1}" />
                                    <Hyperlink NavigateUri="https://github.com/tylercamp/palcalc/wiki/Frequently-Asked-Questions#why-arent-i-getting-any-results"
                                               RequestNavigate="Hyperlink_RequestNavigate">
                                        <Run Text="{itl:LocalizedText Code=LC_NO_RESULTS_FAQ_2}" />
                                    </Hyperlink>
                                    <Run Text="{itl:LocalizedText Code=LC_NO_RESULTS_FAQ_3}" />
                                </TextBlock>
                            </StackPanel>


                            <!-- Solver Results -->
                            <GroupBox Header="{Binding PalTarget.CurrentPalSpecifier.CurrentResults.ResultsHeading.Value, FallbackValue=''}" Grid.Row="1">
                                <v:BreedingResultListView BorderThickness="0" DataContext="{Binding PalTarget.CurrentPalSpecifier.CurrentResults}" />
                            </GroupBox>
                        </Grid>
                    </Grid>

                    <!-- About button / Update Notice -->
                    <StackPanel Grid.Row="2">
                        <Button Click="AboutButton_Click"
                                Margin="{StaticResource Thickness.SM}"
                                HorizontalAlignment="Left"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="{itl:LocalizedText LC_ABOUT_APP}" />
                        <TextBlock Visibility="{Binding UpdatesMessageVisibility}" TextWrapping="Wrap" TextAlignment="Center" FontSize="{StaticResource FontSize.Header}">
                            <!-- NavigateUri unused, value must be set for event to trigger -->
                            <Hyperlink NavigateUri="http://github.com" RequestNavigate="DownloadUpdateLink_RequestNavigate">
                                <TextBlock Text="{itl:LocalizedText LC_UPDATE_AVAILABLE}" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Page>
